{
  "name": "domain-copilot",
  "version": "0.1.0",
  "description": "Domain Copilot - Industrial Field Maintenance (D5) with Human Review Queue (T5)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "test": "vitest run"
  },
  "keywords": [
    "clean-architecture",
    "domain-copilot",
    "industrial-maintenance",
    "human-in-the-loop",
    "pgvector"
  ],
  "author": "Marwa Ashraf",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.22.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
