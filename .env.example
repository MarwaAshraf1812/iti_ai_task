# ==============================================================================
# Domain Copilot Environment Variables
# ==============================================================================

# Node Environment: 'development', 'test', or 'production'
NODE_ENV=development

# Port on which the HTTP server (Fastify) will listen
PORT=3000

# PostgreSQL connection string with pgvector support
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_copilot

# LLM Provider selection: choose between 'openai' (cloud) or 'ollama' (local inference)
LLM_PROVIDER=openai

# OpenAI API Key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama Base URL for local model inference (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model used for vector embeddings in pgvector (e.g., text-embedding-3-small, nomic-embed-text)
EMBEDDING_MODEL=text-embedding-3-small

# Human Review Queue threshold for low-confidence maintenance diagnosis (Twist T5)
REVIEW_QUEUE_CONFIDENCE_THRESHOLD=0.75
