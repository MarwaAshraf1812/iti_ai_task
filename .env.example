# ==============================================================================
# Domain Copilot Environment Variables
# ==============================================================================

# Node Environment: 'development', 'test', or 'production'
NODE_ENV=development

# Port on which the HTTP server (Fastify) will listen
PORT=3000

# PostgreSQL connection string with pgvector support
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/domain_copilot

# Primary LLM Provider: choose between 'gemini' (cloud) or 'ollama' (local inference)
LLM_PROVIDER=gemini

# Google Gemini API Key (required when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini Model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Gemini Embedding Model (default: text-embedding-004)
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama Base URL for local model inference (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Small local model used by Ollama for completions, streaming, and tool calling
OLLAMA_MODEL=qwen2.5:3b

# Local embedding model used by Ollama for vector embeddings
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Human Review Queue threshold for low-confidence maintenance diagnosis (Twist T5)
REVIEW_QUEUE_CONFIDENCE_THRESHOLD=0.75
